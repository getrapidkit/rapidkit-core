import { Injectable } from "@nestjs/common";

export interface LlmGatewayRequest {
    prompt: string;
    model?: string;
    provider?: string;
    tenantId?: string;
    userId?: string;
    maxTokens?: number;
    metadata?: Record<string, unknown>;
}

export interface LlmGatewayResponse {
    text: string;
    provider: string;
    model: string;
    inputChars: number;
    estimatedTokens: number;
    fallbackUsed: boolean;
    metadata: Record<string, unknown>;
}

type Provider = (request: Required<LlmGatewayRequest>) => Promise<LlmGatewayResponse | string> | LlmGatewayResponse | string;

@Injectable()
export class {{ module_class_name }}Service {
    private readonly providers = new Map<string, Provider>();
    private readonly usage: Array<{ provider: string; estimatedTokens: number; fallbackUsed: boolean }> = [];

    constructor() {
        this.registerProvider("local", (request) => ({
            text: `[local:${request.model}] ${request.prompt.trim() || "empty prompt"}`,
            provider: "local",
            model: request.model,
            inputChars: request.prompt.length,
            estimatedTokens: this.estimateTokens(request.prompt, request.maxTokens),
            fallbackUsed: false,
            metadata: { offline: true },
        }));
    }

    registerProvider(name: string, provider: Provider): void {
        const normalized = name.trim().toLowerCase();
        if (!normalized) {
            throw new Error("provider name is required");
        }
        this.providers.set(normalized, provider);
    }

    async complete(payload: LlmGatewayRequest): Promise<LlmGatewayResponse> {
        const request = this.normalizeRequest(payload);
        const plan = this.providerPlan(request.provider);
        const errors: string[] = [];
        for (const [index, providerName] of plan.entries()) {
            const provider = this.providers.get(providerName);
            if (!provider) {
                errors.push(`${providerName}: provider is not registered`);
                continue;
            }
            try {
                const raw = await provider(request);
                const response = this.coerceResponse(raw, providerName, request, index > 0);
                this.usage.push({
                    provider: response.provider,
                    estimatedTokens: response.estimatedTokens,
                    fallbackUsed: response.fallbackUsed,
                });
                return response;
            } catch (error) {
                errors.push(`${providerName}: ${(error as Error).message}`);
            }
        }
        throw new Error(`all providers failed: ${errors.join("; ")}`);
    }

    getStatus(): Record<string, unknown> {
        return {
            module: "{{ module_name }}",
            status: "ok",
            providers: Array.from(this.providers.keys()).sort(),
            usage: this.usageSnapshot(),
        };
    }

    usageSnapshot(): Record<string, unknown> {
        return {
            requests: this.usage.length,
            estimatedTokens: this.usage.reduce((total, item) => total + item.estimatedTokens, 0),
        };
    }

    private normalizeRequest(payload: LlmGatewayRequest): Required<LlmGatewayRequest> {
        const prompt = payload.prompt?.trim();
        if (!prompt) {
            throw new Error("prompt is required");
        }
        return {
            prompt: payload.prompt,
            model: payload.model ?? "default",
            provider: payload.provider ?? "local",
            tenantId: payload.tenantId ?? "",
            userId: payload.userId ?? "",
            maxTokens: payload.maxTokens ?? 512,
            metadata: payload.metadata ?? {},
        };
    }

    private providerPlan(requestedProvider: string): string[] {
        return Array.from(new Set([requestedProvider, "local"].filter(Boolean).map((item) => item.toLowerCase())));
    }

    private coerceResponse(
        raw: LlmGatewayResponse | string,
        provider: string,
        request: Required<LlmGatewayRequest>,
        fallbackUsed: boolean,
    ): LlmGatewayResponse {
        if (typeof raw !== "string") {
            return { ...raw, fallbackUsed };
        }
        return {
            text: raw,
            provider,
            model: request.model,
            inputChars: request.prompt.length,
            estimatedTokens: this.estimateTokens(request.prompt, request.maxTokens),
            fallbackUsed,
            metadata: {},
        };
    }

    private estimateTokens(prompt: string, maxTokens: number): number {
        return Math.max(1, Math.ceil(prompt.length / 4)) + Math.max(0, maxTokens);
    }
}
