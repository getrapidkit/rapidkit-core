from __future__ import annotations

import importlib.util
import os
import sys
from functools import lru_cache
from pathlib import Path
from typing import Any, Dict, List

from fastapi import APIRouter, HTTPException, status
from pydantic import BaseModel, Field

_VENDOR_MODULE = "{{ rapidkit_vendor_module }}"
_VENDOR_VERSION = "{{ rapidkit_vendor_version }}"
_VENDOR_RELATIVE_PATH = "{{ rapidkit_vendor_relative_path }}"
_VENDOR_ROOT_ENV = "RAPIDKIT_VENDOR_ROOT"
_CACHE_PREFIX = "rapidkit_vendor_vector_store"


def _project_root() -> Path:
    current = Path(__file__).resolve()
    for parent in current.parents:
        if (parent / "pyproject.toml").exists():
            return parent
    return current.parents[2]


def _vendor_root() -> Path:
    override = os.getenv(_VENDOR_ROOT_ENV)
    if override:
        return Path(override).expanduser().resolve()
    return _project_root() / ".rapidkit" / "vendor"


def _vendor_base_dir() -> Path:
    module_dir = _vendor_root() / _VENDOR_MODULE
    preferred = module_dir / _VENDOR_VERSION if _VENDOR_VERSION else None
    if preferred and preferred.exists():
        return preferred
    candidates = sorted((path for path in module_dir.glob("*") if path.is_dir()), reverse=True)
    if candidates:
        return candidates[0]
    raise RuntimeError(f"RapidKit vendor payload for {_VENDOR_MODULE!r} not found under {module_dir}")


@lru_cache(maxsize=1)
def _load_vendor_module():
    vendor_path = _vendor_base_dir() / _VENDOR_RELATIVE_PATH
    if not vendor_path.exists():
        raise RuntimeError(f"RapidKit vendor vector_store file missing at {vendor_path}")
    module_name = _CACHE_PREFIX + "_" + _VENDOR_MODULE.replace("/", "_")
    spec = importlib.util.spec_from_file_location(module_name, vendor_path)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"Unable to load vendor vector_store module from {vendor_path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules.setdefault(module_name, module)
    spec.loader.exec_module(module)
    return module


def _resolve_export(name: str):
    module = _load_vendor_module()
    try:
        return getattr(module, name)
    except AttributeError as exc:  # pragma: no cover - defensive against drift
        raise RuntimeError(f"Vendor vector_store module missing attribute {name!r}") from exc


{{ module_class_name }} = _resolve_export("{{ module_class_name }}")
{{ module_class_name }}Config = _resolve_export("{{ module_class_name }}Config")
{{ module_class_name }}Error = _resolve_export("{{ module_class_name }}Error")
VectorDocument = _resolve_export("VectorDocument")
VectorSearchResult = _resolve_export("VectorSearchResult")


class UpsertPayload(BaseModel):
    id: str | None = None
    vector: List[float] = Field(min_length=1)
    text: str = ""
    namespace: str = "default"
    metadata: Dict[str, Any] = Field(default_factory=dict)


class QueryPayload(BaseModel):
    vector: List[float] = Field(min_length=1)
    top_k: int = Field(default=5, ge=1)
    namespace: str = "default"
    metadata_filter: Dict[str, Any] = Field(default_factory=dict)


def _document_payload(document: Any) -> dict[str, Any]:
    return {
        "id": document.id,
        "vector": list(document.vector),
        "text": document.text,
        "metadata": dict(document.metadata),
        "namespace": document.namespace,
        "created_at": document.created_at,
        "updated_at": document.updated_at,
    }


def create_router(store: Any | None = None) -> APIRouter:
    """Provide an application router for {{ module_title }}."""

    router = APIRouter(prefix="/{{ module_kebab }}", tags=["{{ module_name }}"])
    runtime = store or {{ module_class_name }}()

    @router.get("/health")
    async def healthcheck() -> dict[str, Any]:
        return runtime.health()

    @router.get("/stats")
    async def stats() -> dict[str, Any]:
        return runtime.stats()

    @router.post("/documents", status_code=status.HTTP_201_CREATED)
    async def upsert(payload: UpsertPayload) -> dict[str, Any]:
        try:
            document = runtime.upsert(**payload.model_dump())
        except (ValueError, {{ module_class_name }}Error) as exc:
            raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(exc)) from exc
        return _document_payload(document)

    @router.post("/query", status_code=status.HTTP_200_OK)
    async def query(payload: QueryPayload) -> dict[str, Any]:
        try:
            results = runtime.query(**payload.model_dump())
        except (ValueError, {{ module_class_name }}Error) as exc:
            raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(exc)) from exc
        return {
            "results": [
                {
                    "score": result.score,
                    "document": _document_payload(result.document),
                }
                for result in results
            ]
        }

    @router.get("/documents/{document_id}")
    async def get_document(document_id: str, namespace: str = "default") -> dict[str, Any]:
        document = runtime.get(document_id, namespace=namespace)
        if document is None:
            raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="document not found")
        return _document_payload(document)

    @router.delete("/documents/{document_id}")
    async def delete_document(document_id: str, namespace: str = "default") -> dict[str, bool]:
        return {"deleted": runtime.delete(document_id, namespace=namespace)}

    return router


__all__ = [
    "{{ module_class_name }}",
    "{{ module_class_name }}Config",
    "{{ module_class_name }}Error",
    "VectorDocument",
    "VectorSearchResult",
    "create_router",
]
